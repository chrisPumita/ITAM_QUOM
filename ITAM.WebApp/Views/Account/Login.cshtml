@inject ITAM.WebApp.WebAppMetaData AppMeta
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LoginLayout";
}
@model ITAM.WebApp.Models.LoginViewModel

<div class="login-card">
    <div class="login-card__brand">ITAM QUOM</div>
    <h1 class="login-card__title">Iniciar sesión</h1>
    <p class="login-card__subtitle">Gestión y resguardo de activos TI</p>

    <div id="api-connection"
         class="api-connection api-connection--checking login-card__status"
         title="Comprobando API…"
         role="status"
         aria-live="polite"
         data-web-version="@AppMeta.Version"
         data-web-updated="@AppMeta.LastUpdate">
        <span class="api-connection__dot" aria-hidden="true"></span>
        <span class="api-connection__label">API…</span>
    </div>

    <form asp-action="Login" method="post" class="login-card__form" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="text-danger login-card__errors"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary w-100 login-card__submit">Entrar</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@using ITAM.Shared.Enums
@model ITAM.WebApp.Models.Assets.AssetIndexViewModel
@{
    ViewData["Title"] = "Inventario";
    var isAdmin = User.IsInRole(AppRoles.Administrador);
    var today = DateOnly.FromDateTime(DateTime.Today);
}

@section Styles {
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 fw-bold mb-0">Inventario</h1>
        <p class="text-muted small mb-0">@Model.TotalCount activos (filtro actual)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Alta</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Import"><i class="bi bi-upload"></i> Carga masiva</a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Export"
           asp-route-search="@Model.Search" asp-route-status="@Model.Status"
           asp-route-condition="@Model.Condition" asp-route-kind="@Model.Kind"
           asp-route-brandId="@Model.BrandId" asp-route-modelId="@Model.ModelId"
           asp-route-showRetired="@Model.ShowRetired">
            <i class="bi bi-download"></i> Excel
        </a>
    </div>
</div>

<form method="get" class="panel mb-3">
    <div class="panel__body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Buscar</label>
                <input class="form-control form-control-sm" name="search" value="@Model.Search" placeholder="Código, serie, modelo…" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Estado</label>
                <select class="form-select form-select-sm" name="status">
                    <option value="">Todos</option>
                    @if (Model.Status == "Available") { <option value="Available" selected>Disponible / Nuevo</option> } else { <option value="Available">Disponible / Nuevo</option> }
                    @if (Model.Status == "Assigned") { <option value="Assigned" selected>Asignado</option> } else { <option value="Assigned">Asignado</option> }
                    @if (Model.Status == "Maintenance") { <option value="Maintenance" selected>Garantía / Mant.</option> } else { <option value="Maintenance">Garantía / Mant.</option> }
                    @if (isAdmin)
                    {
                        if (Model.Status == "Retired") { <option value="Retired" selected>Baja</option> } else { <option value="Retired">Baja</option> }
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Condición</label>
                <select class="form-select form-select-sm" name="condition">
                    <option value="">Todas</option>
                    @if (Model.Condition == "New") { <option value="New" selected>Nuevo</option> } else { <option value="New">Nuevo</option> }
                    @if (Model.Condition == "Used") { <option value="Used" selected>Usado</option> } else { <option value="Used">Usado</option> }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label small mb-1">Tipo</label>
                <select class="form-select form-select-sm" name="kind">
                    <option value="">Todos</option>
                    @if (Model.Kind == AssetKind.Equipment) { <option value="1" selected>Equipo</option> } else { <option value="1">Equipo</option> }
                    @if (Model.Kind == AssetKind.Accessory) { <option value="2" selected>Accesorio</option> } else { <option value="2">Accesorio</option> }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Marca</label>
                <select class="form-select form-select-sm" name="brandId" id="invBrand">
                    <option value="">Todas</option>
                    @foreach (var b in Model.Brands)
                    {
                        <option value="@b.Id" selected="@(Model.BrandId == b.Id ? "selected" : null)">@b.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Modelo</label>
                <select class="form-select form-select-sm" name="modelId" id="invModel"
                        data-models='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Models.Select(m => new { m.Id, m.Name, m.BrandId, m.BrandName })))'>
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">Filtrar</button>
            </div>
        </div>
        @if (isAdmin)
        {
            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" name="showRetired" value="true" id="showRetired" checked="@Model.ShowRetired" />
                <label class="form-check-label small" for="showRetired">Incluir bajas en “Todos”</label>
            </div>
        }
    </div>
</form>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-sm table-hover table-inventory mb-0 align-middle" id="inventoryTable" style="width:100%">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>SN</th>
                    <th>Descripción</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Proveedor</th>
                    <th>Garantía</th>
                    <th>Ubicación / Custodio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Items)
            {
                var rowClass = a.Status == AssetStatus.Retired ? "row-retired" : "";
                var warrantyLabel = "—";
                var warrantyClass = "text-muted";
                if (a.WarrantyEndDate is { } wed)
                {
                    if (wed < today)
                    {
                        warrantyLabel = $"Venció {wed:yyyy-MM-dd}";
                        warrantyClass = "text-danger";
                    }
                    else
                    {
                        warrantyLabel = wed.ToString("yyyy-MM-dd");
                        warrantyClass = "";
                    }
                }
                <tr class="@rowClass">
                    <td class="font-mono">@a.AssetCode</td>
                    <td class="font-mono">@(a.SerialNumber ?? "—")</td>
                    <td>@a.Description</td>
                    <td>@a.Kind.ToSpanish()</td>
                    <td>
                        @{
                            var badgeClass = a.Status switch
                            {
                                AssetStatus.Available when a.Condition == AssetCondition.New => "status-new",
                                AssetStatus.Available => "status-available",
                                AssetStatus.Assigned => "status-assigned",
                                AssetStatus.Maintenance => "status-maintenance",
                                _ => "status-retired"
                            };
                        }
                        <span class="status-badge @badgeClass">
                            <span class="status-badge__dot"></span> @a.StatusLabel
                        </span>
                    </td>
                    <td>@(a.SupplierName ?? "—")</td>
                    <td class="@warrantyClass">@warrantyLabel</td>
                    <td>
                        @if (a.Status == AssetStatus.Assigned)
                        {
                            <span class="custodian-chip"><i class="bi bi-person"></i> @(a.CurrentEmployeeName ?? "—")</span>
                        }
                        else
                        {
                            <span class="text-muted">@(a.LocationName ?? "—")</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@a.Id">Ver</a>
                        @if (a.Status == AssetStatus.Available)
                        {
                            <a class="btn btn-sm btn-primary" asp-controller="Assignments" asp-action="Assign">Asignar</a>
                            <form asp-action="SetMaintenance" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="returnTo" value="Index" />
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Enviar a garantía">Garantía</button>
                            </form>
                            @if (isAdmin)
                            {
                                <form asp-action="SetStatus" method="post" class="d-inline" onsubmit="return confirm('¿Dar de baja @a.AssetCode?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.Id" />
                                    <input type="hidden" name="status" value="@AssetStatus.Retired" />
                                    <input type="hidden" name="returnTo" value="Index" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Baja</button>
                                </form>
                            }
                        }
                        else if (a.Status == AssetStatus.Assigned)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Assignments" asp-action="Return" asp-route-mode="code" asp-route-assetCode="@a.AssetCode">Devolver</a>
                        }
                        else if (a.Status == AssetStatus.Maintenance)
                        {
                            <form asp-action="ExitMaintenance" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="returnTo" value="Index" />
                                <button type="submit" class="btn btn-sm btn-outline-success">Disponible</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
(function () {
  const brand = document.getElementById('invBrand');
  const model = document.getElementById('invModel');
  const selected = '@(Model.ModelId?.ToString() ?? "")';
  let models = [];
  try { models = JSON.parse(model.getAttribute('data-models') || '[]'); } catch { models = []; }
  function fill() {
    const bid = brand.value ? parseInt(brand.value, 10) : null;
    model.innerHTML = '<option value="">Todos</option>';
    models.filter(m => !bid || m.BrandId === bid).forEach(m => {
      const o = document.createElement('option');
      o.value = m.Id;
      o.textContent = m.BrandName + ' ' + m.Name;
      if (String(m.Id) === selected) o.selected = true;
      model.appendChild(o);
    });
  }
  brand.addEventListener('change', fill);
  fill();

  $('#inventoryTable').DataTable({
    pageLength: 25,
    order: [[0, 'asc']],
    language: {
      url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json'
    },
    columnDefs: [{ orderable: false, targets: -1 }]
  });
})();
</script>
}

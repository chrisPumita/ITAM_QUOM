@model ITAM.WebApp.Models.Assets.AssetImportViewModel
@{
    ViewData["Title"] = "Carga masiva";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Carga masiva</h1>
    <p class="text-muted small mb-0">Plantilla con ~50 ejemplos. Use <strong>Marca</strong> y <strong>Modelo</strong> por nombre (no IDs); se crean si faltan. Marca se guarda en MAYÚSCULAS.</p>
</div>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="ImportTemplate"><i class="bi bi-download"></i> Plantilla</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Volver al inventario</a>
</div>

<form asp-action="Import" method="post" enctype="multipart/form-data" class="panel" style="max-width:520px">
    @Html.AntiForgeryToken()
    <div class="panel__body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-3">
            <label class="form-label">Archivo Excel</label>
            <input type="file" name="file" class="form-control" accept=".xlsx" required />
        </div>
        <button type="submit" class="btn btn-primary">Procesar y guardar</button>
    </div>
</form>

@if (Model.Created > 0 || Model.Failed > 0)
{
    <div class="panel mt-3" style="max-width:640px">
        <div class="panel__body">
            <p class="mb-2">@Model.ResultMessage</p>
            @if (Model.CreatedCodes.Count > 0)
            {
                <p class="small mb-1">Códigos creados:</p>
                <ul class="small font-mono">
                    @foreach (var c in Model.CreatedCodes.Take(50))
                    {
                        <li>@c</li>
                    }
                </ul>
            }
            @if (Model.Errors.Count > 0)
            {
                <p class="small text-danger mb-1">Errores:</p>
                <ul class="small text-danger">
                    @foreach (var e in Model.Errors.Take(30))
                    {
                        <li>@e</li>
                    }
                </ul>
            }
        </div>
    </div>
}

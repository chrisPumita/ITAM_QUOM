@using ITAM.Shared.Enums
@model ITAM.WebApp.Models.Assets.AssetCreateViewModel
@{
    ViewData["Title"] = "Alta de activo";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Alta de activo</h1>
    <p class="text-muted small mb-0">El código de etiqueta se genera al guardar. Queda <strong>Nuevo</strong> hasta la primera asignación.</p>
</div>

<form asp-action="Create" method="post" class="panel" style="max-width:720px" id="altaForm">
    @Html.AntiForgeryToken()
    <div class="panel__body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Tipo</label>
            <select asp-for="Kind" class="form-select" id="kind">
                <option value="@AssetKind.Equipment">Equipo</option>
                <option value="@AssetKind.Accessory">Accesorio</option>
            </select>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0">Marca</label>
                <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="collapse" data-bs-target="#quickBrand">+ Nueva marca</button>
            </div>
            <select class="form-select" id="filterBrand" asp-for="FilterBrandId">
                <option value="">Todas</option>
                @foreach (var b in Model.Brands.Where(x => x.IsActive))
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
            <div class="collapse mt-2" id="quickBrand">
                <div class="border rounded p-2 bg-light">
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control text-uppercase" id="newBrandName" placeholder="Nombre (MAYÚSCULAS)" maxlength="100" />
                        <button type="button" class="btn btn-outline-primary" id="btnSaveBrand">Guardar marca</button>
                    </div>
                    <div class="form-text">Se normaliza a mayúsculas automáticamente.</div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0">Modelo</label>
                <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="collapse" data-bs-target="#quickModel">+ Nuevo modelo</button>
            </div>
            <select asp-for="ModelId" class="form-select" id="modelSelect" required
                    data-models='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Models.Where(x => x.IsActive).Select(m => new { m.Id, m.Name, m.BrandId, m.BrandName, m.CategoryName })))'>
                <option value="">Seleccione…</option>
            </select>
            <div class="form-text">Obligatorio. Filtra por marca arriba.</div>
            <div class="collapse mt-2" id="quickModel">
                <div class="border rounded p-2 bg-light">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" id="newModelBrand">
                                @foreach (var b in Model.Brands.Where(x => x.IsActive))
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" id="newModelCat">
                                @foreach (var c in Model.Categories.Where(x => x.IsActive))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control form-control-sm" id="newModelName" placeholder="Nombre modelo" maxlength="150" />
                        </div>
                        <div class="col-12">
                            <input type="text" class="form-control form-control-sm" id="newModelSpecs" placeholder="Specs (opcional)" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnSaveModel">Guardar modelo</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Número de serie (SN)</label>
            <input asp-for="SerialNumber" class="form-control font-mono" />
            <div class="form-text">Obligatorio para equipos.</div>
            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Propiedad</label>
            <select asp-for="OwnershipType" class="form-select" id="ownership">
                <option value="@OwnershipType.Owned">Propio</option>
                <option value="@OwnershipType.Rented">Rentado</option>
            </select>
        </div>
        <div class="mb-3" id="supplierWrap">
            <label class="form-label">Proveedor</label>
            <select asp-for="SupplierId" class="form-select">
                <option value="">—</option>
                @foreach (var s in Model.Suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
            <span asp-validation-for="SupplierId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Ubicación</label>
            <select asp-for="LocationId" class="form-select">
                <option value="">—</option>
                @foreach (var l in Model.Locations.Where(x => x.IsActive))
                {
                    <option value="@l.Id">@l.Name</option>
                }
            </select>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <label class="form-label">Compra</label>
                <input asp-for="PurchaseDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fin garantía</label>
                <input asp-for="WarrantyEndDate" type="date" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">IMEI</label>
            <input asp-for="Imei" class="form-control font-mono" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
      const modelSelect = document.getElementById('modelSelect');
      const filterBrand = document.getElementById('filterBrand');
      const selectedModel = '@Model.ModelId';
      let models = [];
      try { models = JSON.parse(modelSelect.getAttribute('data-models') || '[]'); } catch { models = []; }

      function fillModels() {
        const brandId = filterBrand.value ? parseInt(filterBrand.value, 10) : null;
        const prev = modelSelect.value || selectedModel;
        modelSelect.innerHTML = '<option value="">Seleccione…</option>';
        models.filter(m => !brandId || m.BrandId === brandId).forEach(m => {
          const opt = document.createElement('option');
          opt.value = m.Id;
          opt.textContent = `${m.BrandName} ${m.Name} — ${m.CategoryName}`;
          if (String(m.Id) === String(prev)) opt.selected = true;
          modelSelect.appendChild(opt);
        });
      }

      filterBrand.addEventListener('change', fillModels);
      fillModels();

      const token = document.querySelector('#altaForm input[name="__RequestVerificationToken"]').value;

      document.getElementById('btnSaveBrand').addEventListener('click', async () => {
        const name = document.getElementById('newBrandName').value.trim();
        if (!name) return;
        const res = await fetch('@Url.Action("QuickCreateBrand")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
          body: JSON.stringify({ name })
        });
        const data = await res.json();
        if (!data.ok) { alert(data.message || 'Error'); return; }
        const opt = document.createElement('option');
        opt.value = data.id; opt.textContent = data.name; opt.selected = true;
        filterBrand.appendChild(opt);
        const opt2 = opt.cloneNode(true);
        document.getElementById('newModelBrand').appendChild(opt2);
        filterBrand.value = data.id;
        fillModels();
        document.getElementById('newBrandName').value = '';
        bootstrap.Collapse.getOrCreateInstance(document.getElementById('quickBrand')).hide();
      });

      document.getElementById('btnSaveModel').addEventListener('click', async () => {
        const brandId = parseInt(document.getElementById('newModelBrand').value, 10);
        const categoryId = parseInt(document.getElementById('newModelCat').value, 10);
        const name = document.getElementById('newModelName').value.trim();
        const specs = document.getElementById('newModelSpecs').value.trim();
        if (!name || !brandId || !categoryId) return;
        const res = await fetch('@Url.Action("QuickCreateModel")', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
          body: JSON.stringify({ name, brandId, categoryId, specs: specs || null })
        });
        const data = await res.json();
        if (!data.ok) { alert(data.message || 'Error'); return; }
        models.push({ Id: data.id, Name: data.name, BrandId: data.brandId, BrandName: data.brandName, CategoryName: data.categoryName });
        filterBrand.value = data.brandId;
        fillModels();
        modelSelect.value = String(data.id);
        document.getElementById('newModelName').value = '';
        document.getElementById('newModelSpecs').value = '';
        bootstrap.Collapse.getOrCreateInstance(document.getElementById('quickModel')).hide();
      });
    })();
    </script>
}

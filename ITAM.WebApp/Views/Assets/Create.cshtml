@using ITAM.Shared.Enums
@model ITAM.WebApp.Models.Assets.AssetCreateViewModel
@{
    ViewData["Title"] = "Alta de activo";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Alta de activo</h1>
</div>

<form asp-action="Create" method="post" class="panel" style="max-width:720px" id="altaForm"
      data-sync-warranty="true"
      data-quick-brand-url="@Url.Action("QuickCreateBrand")"
      data-quick-model-url="@Url.Action("QuickCreateModel")">
    @Html.AntiForgeryToken()
    <div class="panel__body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Tipo</label>
            <select asp-for="Kind" class="form-select" id="kind">
                <option value="@AssetKind.Equipment">Equipo</option>
                <option value="@AssetKind.Accessory">Accesorio</option>
            </select>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0">Marca</label>
                <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="collapse" data-bs-target="#quickBrand">+ Nueva marca</button>
            </div>
            <select class="form-select" id="filterBrand" asp-for="FilterBrandId">
                <option value="">Seleccione marca…</option>
                @foreach (var b in Model.Brands.Where(x => x.IsActive))
                {
                    <option value="@b.Id">@b.Name</option>
                }
            </select>
            <div class="collapse mt-2" id="quickBrand">
                <div class="border rounded p-2 bg-light">
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control text-uppercase" id="newBrandName" placeholder="Nombre (MAYÚSCULAS)" maxlength="100" />
                        <button type="button" class="btn btn-outline-primary" id="btnSaveBrand">Guardar marca</button>
                    </div>
                    <div class="form-text">Se guarda en mayúsculas.</div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label mb-0">Modelo</label>
                <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="collapse" data-bs-target="#quickModel">+ Nuevo modelo</button>
            </div>
            <select asp-for="ModelId" class="form-select" id="modelSelect" required disabled
                    data-models='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Models.Where(x => x.IsActive).Select(m => new { m.Id, m.Name, m.BrandId, m.BrandName, m.CategoryName })))'
                    data-selected="@(Model.ModelId > 0 ? Model.ModelId.ToString() : "")">
                <option value="">Seleccione…</option>
            </select>
            <div class="collapse mt-2" id="quickModel">
                <div class="border rounded p-2 bg-light">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" id="newModelBrand">
                                @foreach (var b in Model.Brands.Where(x => x.IsActive))
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" id="newModelCat">
                                @foreach (var c in Model.Categories.Where(x => x.IsActive))
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control form-control-sm" id="newModelName" placeholder="Nombre modelo" maxlength="150" />
                        </div>
                        <div class="col-12">
                            <input type="text" class="form-control form-control-sm" id="newModelSpecs" placeholder="Specs (opcional)" />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnSaveModel">Guardar modelo</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Número de serie (SN)</label>
            <input asp-for="SerialNumber" class="form-control font-mono" />
            <div class="form-text">Obligatorio para equipos.</div>
            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Propiedad</label>
            <select asp-for="OwnershipType" class="form-select" id="ownership">
                <option value="@OwnershipType.Owned">Propio</option>
                <option value="@OwnershipType.Rented">Rentado</option>
            </select>
        </div>
        <div class="mb-3" id="supplierWrap">
            <label class="form-label">Proveedor</label>
            <select asp-for="SupplierId" class="form-select">
                <option value="">—</option>
                @foreach (var s in Model.Suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
            <span asp-validation-for="SupplierId" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Ubicación</label>
            <select asp-for="LocationId" class="form-select">
                <option value="">—</option>
                @foreach (var l in Model.Locations.Where(x => x.IsActive))
                {
                    <option value="@l.Id">@l.Name</option>
                }
            </select>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <label class="form-label">Compra</label>
                <input asp-for="PurchaseDate" type="date" class="form-control" id="purchaseDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fin garantía</label>
                <input asp-for="WarrantyEndDate" type="date" class="form-control" id="warrantyEndDate" />
                <div class="form-text">Por defecto: compra + 1 año.</div>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">IMEI</label>
            <input asp-for="Imei" class="form-control font-mono" />
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/asset-form.js" asp-append-version="true"></script>
}

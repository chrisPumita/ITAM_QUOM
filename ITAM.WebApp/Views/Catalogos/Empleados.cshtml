@using ITAM.Shared.Dtos.Company
@model List<EmployeeListDto>
@{
    ViewData["Title"] = "Empleados";
    var search = (string?)ViewBag.Search;
    var onlyActive = (bool?)ViewBag.OnlyActive;
}
@await Html.PartialAsync("_CatalogTabs", "empleados")

<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <h1 class="h5 fw-bold mb-0">Empleados</h1>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4"><input class="form-control form-control-sm" name="search" value="@search" placeholder="Buscar empleado…" /></div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" name="onlyActive">
            <option value="">Todos</option>
            <option value="true" selected="@(onlyActive == true ? "selected" : null)">Solo activos</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-outline-secondary" type="submit">Filtrar</button></div>
</form>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <div class="table-responsive">
                <table class="table table-sm table-catalog mb-0 align-middle">
                    <thead><tr><th>Número</th><th>Nombre</th><th>Email</th><th>Depto</th><th>Activo</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="font-mono">@e.EmployeeNumber</td>
                            <td>@e.FullName</td>
                            <td>@e.Email</td>
                            <td>@e.Department</td>
                            <td>
                                <form asp-action="ToggleEmployee" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@e.Id" />
                                    <input type="hidden" name="isActive" value="@(!e.IsActive)" />
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" @(e.IsActive ? "checked" : null)
                                               onchange="this.form.submit()" />
                                    </div>
                                </form>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="editEmployee('@e.Id', '@e.EmployeeNumber.Replace("'", "\\'")', '@e.FullName.Replace("'", "\\'")', '@e.Email.Replace("'", "\\'")', '@(e.Department?.Replace("'", "\\'") ?? "")', @(e.IsActive ? "true" : "false"))">Editar</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <form asp-action="SaveEmployee" method="post" class="panel" id="formEmployee">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="employeeId" />
            <div class="panel__header"><h2 class="panel__title" id="employeeFormTitle">Nuevo empleado</h2></div>
            <div class="panel__body">
                <div class="mb-2"><label class="form-label">Número</label><input name="EmployeeNumber" id="employeeNumber" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Nombre</label><input name="FullName" id="employeeFullName" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Email</label><input name="Email" id="employeeEmail" type="email" class="form-control" required /></div>
                <div class="mb-2"><label class="form-label">Depto</label><input name="Department" id="employeeDepartment" class="form-control" /></div>
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="IsActive" value="true" id="employeeActive" checked /><label class="form-check-label" for="employeeActive">Activo</label></div>
                <button class="btn btn-primary btn-sm" type="submit">Guardar</button>
                <button type="button" class="btn btn-link btn-sm" onclick="resetEmployee()">Limpiar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function editEmployee(id, number, fullName, email, department, active) {
  document.getElementById('employeeId').value = id;
  document.getElementById('employeeNumber').value = number;
  document.getElementById('employeeFullName').value = fullName;
  document.getElementById('employeeEmail').value = email;
  document.getElementById('employeeDepartment').value = department || '';
  document.getElementById('employeeActive').checked = active;
  document.getElementById('employeeFormTitle').textContent = 'Editar empleado';
}
function resetEmployee() {
  document.getElementById('employeeId').value = '';
  document.getElementById('employeeNumber').value = '';
  document.getElementById('employeeFullName').value = '';
  document.getElementById('employeeEmail').value = '';
  document.getElementById('employeeDepartment').value = '';
  document.getElementById('employeeActive').checked = true;
  document.getElementById('employeeFormTitle').textContent = 'Nuevo empleado';
}
</script>
}

@using ITAM.Shared.Dtos.Catalog
@model List<LocationListDto>
@{
    ViewData["Title"] = "Ubicaciones";
    var search = (string?)ViewBag.Search;
    var onlyActive = (bool?)ViewBag.OnlyActive;
}
@await Html.PartialAsync("_CatalogTabs", "ubicaciones")

<div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
    <h1 class="h5 fw-bold mb-0">Ubicaciones</h1>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-4"><input class="form-control form-control-sm" name="search" value="@search" placeholder="Buscar ubicación…" /></div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" name="onlyActive">
            <option value="">Todos</option>
            <option value="true" selected="@(onlyActive == true ? "selected" : null)">Solo activos</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-sm btn-outline-secondary" type="submit">Filtrar</button></div>
</form>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="panel">
            <div class="table-responsive">
                <table class="table table-sm table-catalog mb-0 align-middle">
                    <thead><tr><th>Nombre</th><th>Almacén</th><th>Activo</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>@l.Name</td>
                            <td>@(l.IsWarehouse ? "Sí" : "")</td>
                            <td>
                                <form asp-action="ToggleLocation" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@l.Id" />
                                    <input type="hidden" name="isActive" value="@(!l.IsActive)" />
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" @(l.IsActive ? "checked" : null)
                                               onchange="this.form.submit()" />
                                    </div>
                                </form>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        onclick="editLocation(@l.Id, '@l.Name.Replace("'", "\\'")', @(l.IsWarehouse ? "true" : "false"), @(l.IsActive ? "true" : "false"))">Editar</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <form asp-action="SaveLocation" method="post" class="panel" id="formLocation">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="locationId" />
            <div class="panel__header"><h2 class="panel__title" id="locationFormTitle">Nueva ubicación</h2></div>
            <div class="panel__body">
                <div class="mb-2"><label class="form-label">Nombre</label><input name="Name" id="locationName" class="form-control" required /></div>
                <div class="form-check mb-2"><input class="form-check-input" type="checkbox" name="IsWarehouse" value="true" id="locationWarehouse" /><label class="form-check-label" for="locationWarehouse">Es almacén</label></div>
                <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="IsActive" value="true" id="locationActive" checked /><label class="form-check-label" for="locationActive">Activo</label></div>
                <button class="btn btn-primary btn-sm" type="submit">Guardar</button>
                <button type="button" class="btn btn-link btn-sm" onclick="resetLocation()">Limpiar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
function editLocation(id, name, isWarehouse, active) {
  document.getElementById('locationId').value = id;
  document.getElementById('locationName').value = name;
  document.getElementById('locationWarehouse').checked = isWarehouse;
  document.getElementById('locationActive').checked = active;
  document.getElementById('locationFormTitle').textContent = 'Editar ubicación';
}
function resetLocation() {
  document.getElementById('locationId').value = '';
  document.getElementById('locationName').value = '';
  document.getElementById('locationWarehouse').checked = false;
  document.getElementById('locationActive').checked = true;
  document.getElementById('locationFormTitle').textContent = 'Nueva ubicación';
}
</script>
}

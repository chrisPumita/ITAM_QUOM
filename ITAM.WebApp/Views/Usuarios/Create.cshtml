@using ITAM.Shared.Dtos.Auth
@using ITAM.Shared.Enums
@model CreateAdminUserDto
@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Nuevo administrador / operador</h1>
    <p class="text-muted small mb-0">Se genera una contraseña temporal. Si SMTP está configurado, se envía por correo con el enlace de acceso.</p>
</div>

<form asp-action="Create" method="post" class="panel" style="max-width:520px">
    @Html.AntiForgeryToken()
    <div class="panel__body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="DisplayName">Nombre</label>
            <input asp-for="DisplayName" class="form-control" required maxlength="120" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email">Correo</label>
            <input asp-for="Email" type="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Role">Rol</label>
            <select asp-for="Role" class="form-select">
                <option value="@AppRoles.Administrador">Administrador</option>
                <option value="@AppRoles.Operador">Operador</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="PublicAppBaseUrl">URL de acceso (Web)</label>
            <input asp-for="PublicAppBaseUrl" class="form-control font-mono" />
            <div class="form-text">Se usa en el correo / enlace. Ej. https://localhost:7048 o su dominio hospedado.</div>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="SendEmail" />
            <label class="form-check-label" asp-for="SendEmail">Intentar enviar correo con contraseña</label>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Crear</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </div>
</form>

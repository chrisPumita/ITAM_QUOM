@using ITAM.Shared.Dtos.Auth
@model List<IdentityUserListDto>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h4 fw-bold mb-0">Usuarios</h1>
        <p class="text-muted small mb-0">Administradores y operadores con acceso al sistema.</p>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="Create"><i class="bi bi-person-plus"></i> Nuevo usuario</a>
</div>

@if (TempData["ResetPassword"] is string tempPw)
{
    <div class="alert alert-warning">
        Contraseña temporal para <strong>@TempData["ResetEmail"]</strong>:
        <code class="user-select-all">@tempPw</code>
        — cópiela ahora; no se mostrará de nuevo.
    </div>
}

<div class="panel mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <div>
            <div class="fw-semibold">Probar correo</div>
            <div class="text-muted small">Envía un mensaje de prueba.</div>
        </div>
    </div>
    <form asp-action="TestEmail" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-6">
            <label class="form-label small mb-0">Destinatario</label>
            <input type="email" name="toEmail" class="form-control form-control-sm"
                   placeholder="Escriba el correo" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-envelope-check"></i> Enviar prueba
            </button>
        </div>
    </form>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Activo</th>
                    <th>Bloqueo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">Sin usuarios.</td></tr>
            }
            else
            {
                foreach (var u in Model)
                {
                    <tr>
                        <td>@u.DisplayName</td>
                        <td class="font-mono small">@u.Email</td>
                        <td>@(u.Role ?? "—")</td>
                        <td>@(u.IsActive ? "Sí" : "No")</td>
                        <td>@(u.IsLockedOut ? "Bloqueado" : "—")</td>
                        <td class="text-end text-nowrap">
                            <form asp-action="ResetPassword" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Restablecer contraseña de @u.Email? Se generará una temporal.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@u.Id" />
                                <input type="hidden" name="sendEmail" value="true" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Restablecer contraseña">
                                    <i class="bi bi-key"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@using ITAM.Shared.Enums
@using System.Text.Json
@model ITAM.WebApp.Models.Assignments.AssignViewModel
@{
    ViewData["Title"] = "Asignar";
    var preselected = Model.SelectedAssetIds ?? [];
    var initialAssetsJson = JsonSerializer.Serialize(Model.AvailableAssets.Select(a => new
    {
        id = a.Id,
        assetCode = a.AssetCode,
        serialNumber = a.SerialNumber,
        description = a.Description,
        condition = a.Condition.ToString(),
        conditionLabel = a.Condition.ToSpanish(),
        kind = (int)a.Kind,
        kindLabel = a.Kind.ToSpanish(),
        brandId = a.BrandId,
        brandName = a.BrandName,
        modelId = a.ModelId,
        categoryName = a.CategoryName
    }));
    var modelsJson = JsonSerializer.Serialize(
        Model.Models.Where(m => m.IsActive).Select(m => new { m.Id, m.Name, m.BrandId, m.BrandName }));
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Asignar activos</h1>
</div>

<form asp-action="Assign" method="post" class="assign-workbench" id="assignForm"
      data-available-url="@Url.Action("AvailableAssets", "Assignments")"
      data-emp-url="@Url.Action("EmployeeAssignments", "Assignments")"
      data-preselected='@Html.Raw(JsonSerializer.Serialize(preselected))'
      data-initial-assets='@Html.Raw(initialAssetsJson)'>
    @Html.AntiForgeryToken()
    <div id="selectedIdsHost"></div>

    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <div class="row g-3 align-items-start">
        <aside class="col-lg-3">
            <div class="panel assign-filters panel--sticky mb-0" id="assignFilters">
                <div class="panel__header">
                    <h2 class="panel__title">Filtros</h2>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearFilters">Limpiar</button>
                </div>
                <div class="panel__body">
                    <div class="mb-3">
                        <label class="form-label small mb-1" for="assetSearch">Buscar</label>
                        <input type="search" id="assetSearch" class="form-control form-control-sm"
                               placeholder="Código, serie o descripción…" autocomplete="off" />
                    </div>

                    <div class="filter-bar filter-bar--sidebar">
                        <div class="filter-bar__group">
                            <span class="filter-bar__label">Tipo</span>
                            <div class="filter-chips" data-filter="kinds">
                                <label class="filter-chip">
                                    <input type="checkbox" value="1" />
                                    <span>Equipo</span>
                                </label>
                                <label class="filter-chip">
                                    <input type="checkbox" value="2" />
                                    <span>Accesorio</span>
                                </label>
                            </div>
                        </div>
                        <div class="filter-bar__group">
                            <span class="filter-bar__label">Condición</span>
                            <div class="filter-chips" data-filter="conditions">
                                <label class="filter-chip">
                                    <input type="checkbox" value="New" />
                                    <span>Nuevo</span>
                                </label>
                                <label class="filter-chip">
                                    <input type="checkbox" value="Used" />
                                    <span>Usado</span>
                                </label>
                            </div>
                        </div>
                        <div class="filter-bar__group">
                            <span class="filter-bar__label">Categoría</span>
                            <div class="filter-chips filter-chips--wrap" data-filter="categoryIds">
                                @foreach (var c in Model.Categories.Where(x => x.IsActive))
                                {
                                    <label class="filter-chip">
                                        <input type="checkbox" value="@c.Id" />
                                        <span>@c.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="filter-bar__group">
                            <span class="filter-bar__label">Marca</span>
                            <div class="filter-chips filter-chips--wrap" data-filter="brandIds">
                                @foreach (var b in Model.Brands.Where(x => x.IsActive))
                                {
                                    <label class="filter-chip">
                                        <input type="checkbox" value="@b.Id" data-brand="@b.Id" />
                                        <span>@b.Name</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="filter-bar__group" id="modelFilterGroup">
                            <span class="filter-bar__label">Modelo</span>
                            <div class="filter-chips filter-chips--wrap" data-filter="modelIds" id="modelChips"
                                 data-models='@Html.Raw(modelsJson)'>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="col-lg-9">
            <div class="row g-3 mb-3 align-items-start">
                <div class="col-lg-7">
                    <div class="panel mb-0">
                        <div class="panel__body">
                            <div class="mb-3">
                                <label class="form-label" for="employeeSelect">Colaborador</label>
                                <select asp-for="EmployeeId" class="form-select" id="employeeSelect" required>
                                    <option value="">Seleccione…</option>
                                    @foreach (var e in Model.Employees)
                                    {
                                        <option value="@e.Id">@e.FullName (@e.EmployeeNumber)</option>
                                    }
                                </select>
                            </div>

                            <div id="empAssignmentsWrap" class="mb-3 d-none">
                                <div class="assign-existing">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="small">Ya tiene asignados</strong>
                                        <span class="badge text-bg-secondary" id="empAssignCount">0</span>
                                    </div>
                                    <ul class="small mb-0 ps-3" id="empAssignList"></ul>
                                </div>
                            </div>

                            <div class="mb-0">
                                <label class="form-label" for="Notes">Notas (opcional)</label>
                                <input asp-for="Notes" class="form-control" maxlength="1000" id="Notes" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="panel assign-summary panel--sticky mb-0">
                        <div class="panel__header">
                            <h2 class="panel__title">Resumen</h2>
                            <span class="badge text-bg-primary" id="summaryCount">0</span>
                        </div>
                        <div class="panel__body">
                            <p class="small text-muted mb-2" id="summaryEmployeeHint">Seleccione colaborador y activos.</p>
                            <ul class="assign-summary__list" id="summaryList"></ul>
                            <p class="small text-muted mb-3 d-none" id="summaryEmpty">Ningún activo seleccionado.</p>
                            <button type="submit" class="btn btn-primary w-100" id="btnAssign" disabled>
                                Asignar y emitir responsiva
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel mb-0">
                <div class="panel__header">
                    <h2 class="panel__title">Disponibles</h2>
                    <span class="small text-muted" id="tableCount">0</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0" id="assetsTable">
                        <thead>
                            <tr>
                                <th style="width:2rem"></th>
                                <th>SKU</th>
                                <th>SN</th>
                                <th>Descripción</th>
                                <th>Condición</th>
                                <th>Tipo</th>
                            </tr>
                        </thead>
                        <tbody id="assetsTbody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/assign.js" asp-append-version="true"></script>
}

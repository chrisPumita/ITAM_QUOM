@using ITAM.Shared.Enums
@model ITAM.WebApp.Models.Assignments.AssignViewModel
@{
    ViewData["Title"] = "Asignar";
    var selected = new HashSet<Guid>(Model.SelectedAssetIds ?? []);
}

<div class="mb-3">
    <h1 class="h4 fw-bold mb-1">Asignar activos</h1>
    <p class="text-muted small mb-0">Solo disponibles. Se genera folio RES automáticamente.</p>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <input class="form-control form-control-sm" name="search" value="@Model.Search" placeholder="Código / filtrar…" />
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" name="kind">
            <option value="">Equipo y accesorio</option>
            <option value="1" selected="@(Model.Kind == AssetKind.Equipment ? "selected" : null)">Equipo</option>
            <option value="2" selected="@(Model.Kind == AssetKind.Accessory ? "selected" : null)">Accesorio</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" name="condition">
            <option value="">Nuevo / Usado</option>
            <option value="New" selected="@(Model.Condition == AssetCondition.New ? "selected" : null)">Nuevo</option>
            <option value="Used" selected="@(Model.Condition == AssetCondition.Used ? "selected" : null)">Usado</option>
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" name="brandId" id="assignBrand">
            <option value="">Todas las marcas</option>
            @foreach (var b in Model.Brands)
            {
                <option value="@b.Id" selected="@(Model.BrandId == b.Id ? "selected" : null)">@b.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" name="modelId" id="assignModel" disabled
                data-models='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Models.Select(m => new { m.Id, m.Name, m.BrandId, m.BrandName })))'
                data-selected="@(Model.ModelId?.ToString() ?? "")">
            <option value="">Seleccione marca…</option>
        </select>
    </div>
    <div class="col-md-1">
        <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Buscar</button>
    </div>
</form>

<form asp-action="Assign" method="post" class="panel" id="assignForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Search" />
    <input type="hidden" asp-for="Kind" />
    <input type="hidden" asp-for="Condition" />
    <input type="hidden" asp-for="BrandId" />
    <input type="hidden" asp-for="ModelId" />
    <div class="panel__body">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <div class="mb-3" style="max-width:420px">
            <label class="form-label">Colaborador</label>
            <select asp-for="EmployeeId" class="form-select" id="employeeSelect" required>
                <option value="">Seleccione…</option>
                @foreach (var e in Model.Employees)
                {
                    <option value="@e.Id">@e.FullName (@e.EmployeeNumber)</option>
                }
            </select>
        </div>
        <div id="empAssignmentsWrap" class="mb-3 d-none">
            <div class="border rounded p-2 bg-light">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong class="small">Ya tiene asignados</strong>
                    <span class="badge text-bg-secondary" id="empAssignCount">0</span>
                </div>
                <p class="small text-muted mb-2 mb-0">Revise antes de entregar más equipo; pida devolución si corresponde un cambio.</p>
                <ul class="small mb-0 ps-3" id="empAssignList"></ul>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Notas (opcional)</label>
            <input asp-for="Notes" class="form-control" maxlength="1000" />
        </div>

        <div class="table-responsive mb-3">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:2rem"></th>
                        <th>SKU</th>
                        <th>SN</th>
                        <th>Descripción</th>
                        <th>Condición</th>
                        <th>Tipo</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.AvailableAssets.Count == 0)
                {
                    <tr><td colspan="6" class="text-muted text-center py-3">No hay activos disponibles.</td></tr>
                }
                else
                {
                    foreach (var a in Model.AvailableAssets)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" name="SelectedAssetIds" value="@a.Id" class="form-check-input asset-check"
                                       @(selected.Contains(a.Id) ? "checked" : null) />
                            </td>
                            <td class="font-mono">@a.AssetCode</td>
                            <td class="font-mono small">@(a.SerialNumber ?? "—")</td>
                            <td>@a.Description</td>
                            <td>@a.Condition.ToSpanish()</td>
                            <td>@a.Kind.ToSpanish()</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <button type="submit" class="btn btn-primary" id="btnAssign">Asignar y emitir responsiva</button>
    </div>
</form>

@section Scripts {
<script>
(function () {
  window.itamBindBrandModel && itamBindBrandModel('assignBrand', 'assignModel');

  const empSelect = document.getElementById('employeeSelect');
  const wrap = document.getElementById('empAssignmentsWrap');
  const list = document.getElementById('empAssignList');
  const countBadge = document.getElementById('empAssignCount');
  const urlTemplate = '@Url.Action("EmployeeAssignments", "Assignments")';

  async function loadEmpAssignments() {
    const id = empSelect.value;
    if (!id) {
      wrap.classList.add('d-none');
      list.innerHTML = '';
      return;
    }
    try {
      const res = await fetch(urlTemplate + '?employeeId=' + encodeURIComponent(id), { headers: { Accept: 'application/json' } });
      const data = await res.json();
      list.innerHTML = '';
      if (!Array.isArray(data) || data.length === 0) {
        countBadge.textContent = '0';
        list.innerHTML = '<li class="text-muted">Sin activos asignados actualmente.</li>';
      } else {
        countBadge.textContent = String(data.length);
        data.forEach(a => {
          const li = document.createElement('li');
          li.innerHTML = `<span class="font-monospace">${a.assetCode}</span> · ${a.description || ''} <span class="text-muted">(${a.assignedAt || ''})</span>`;
          list.appendChild(li);
        });
      }
      wrap.classList.remove('d-none');
    } catch {
      wrap.classList.add('d-none');
    }
  }
  empSelect.addEventListener('change', loadEmpAssignments);
  if (empSelect.value) loadEmpAssignments();

  const form = document.getElementById('assignForm');
  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const checks = [...form.querySelectorAll('.asset-check:checked')];
    if (checks.length === 0) {
      await Swal.fire({ icon: 'warning', title: 'Seleccione al menos un activo', confirmButtonColor: '#9C5F26' });
      return;
    }
    const emp = document.getElementById('employeeSelect');
    const empName = emp.options[emp.selectedIndex]?.text || 'colaborador';
    const codes = checks.map(c => c.closest('tr').querySelector('.font-mono')?.textContent?.trim()).filter(Boolean);
    const listHtml = codes.slice(0, 8).map(c => `<li class="font-monospace">${c}</li>`).join('')
      + (codes.length > 8 ? `<li>… y ${codes.length - 8} más</li>` : '');
    const ok = await Swal.fire({
      icon: 'question',
      title: '¿Confirmar asignación?',
      html: `<p>Se asignarán <strong>${checks.length}</strong> activo(s) a <strong>${empName}</strong> y se emitirá la responsiva.</p><ul class="text-start small">${listHtml}</ul>`,
      showCancelButton: true,
      confirmButtonText: 'Sí, asignar',
      cancelButtonText: 'Cancelar',
      confirmButtonColor: '#9C5F26'
    });
    if (ok.isConfirmed) form.submit();
  });
})();
</script>
}

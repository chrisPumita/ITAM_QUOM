@using ITAM.Shared.Enums
@model ITAM.Shared.Dtos.Assignments.CustodyFormDetailDto
@{
    ViewData["Title"] = Model.Folio;
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Responsivas">Responsivas</a></li>
        <li class="breadcrumb-item active font-mono">@Model.Folio</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <h1 class="h4 fw-bold mb-1 font-mono">@Model.Folio</h1>
        <p class="mb-0">@Model.EmployeeName <span class="text-muted small">(@Model.EmployeeNumber)</span></p>
        <span class="badge text-bg-light border">@Model.Status.ToSpanish()</span>
        @if (Model.IssuedAt is not null)
        {
            <span class="small text-muted ms-1">Emitida @Model.IssuedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
        }
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary btn-sm" asp-action="CustodyPdf" asp-route-id="@Model.Id">
            <i class="bi bi-download"></i> Descargar PDF
        </a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Responsivas">Listado</a>
    </div>
</div>

<div class="panel mb-3">
    <div class="panel__header"><h2 class="panel__title">Trazabilidad</h2></div>
    <div class="panel__body">
        <div class="row g-3 small mb-0">
            <div class="col-sm-3">
                <div class="text-muted">Asignó (admin)</div>
                <div class="fw-semibold">@(Model.IssuedByUserName ?? "—")</div>
            </div>
            <div class="col-sm-3">
                <div class="text-muted">Colaborador</div>
                <div>@Model.EmployeeName</div>
            </div>
            <div class="col-sm-3">
                <div class="text-muted">Firmada</div>
                <div>@(Model.SignedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
            </div>
            <div class="col-sm-3">
                <div class="text-muted">Notas</div>
                <div>@(Model.Notes ?? "—")</div>
            </div>
        </div>
    </div>
</div>

<div class="panel mb-3">
    <div class="panel__header"><h2 class="panel__title">Activos</h2></div>
    <div class="panel__body">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>SN</th>
                        <th>Descripción</th>
                        <th>Tipo</th>
                        <th>Condición entrega</th>
                        <th>Devolución / recibió</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td class="font-mono"><a asp-controller="Assets" asp-action="Details" asp-route-id="@l.AssetId">@l.AssetCode</a></td>
                        <td class="font-mono">@(l.SerialNumber ?? "—")</td>
                        <td>@l.BrandName @l.ModelName @(string.IsNullOrEmpty(l.Specs) ? "" : "· " + l.Specs)</td>
                        <td>
                            <div>@l.AssetKind.ToSpanish()</div>
                            <div class="small text-muted">@l.CategoryName</div>
                        </td>
                        <td>@l.ConditionOnDelivery.ToSpanish()</td>
                        <td>
                            @if (l.ReturnedAt is null)
                            {
                                <span class="text-warning small">Pendiente</span>
                            }
                            else
                            {
                                <div>@l.ReturnedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                <div class="small text-muted">Recibió: @(l.ReturnedByUserName ?? "—")</div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_LoginLayout";
}

<div class="login-card">
    <div class="login-card__brand">ITAM QUOM</div>
    <h1 class="login-card__title text-danger">Error</h1>
    <p class="login-card__subtitle">Ocurrió un problema al procesar la solicitud.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-3">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Inicio</a>
        <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Login</a>
    </div>
</div>

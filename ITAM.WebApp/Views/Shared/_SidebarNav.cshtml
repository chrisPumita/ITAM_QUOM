@using ITAM.Shared.Enums
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    string LinkClass(string forController, string? forAction = null)
    {
        var active = string.Equals(controller, forController, StringComparison.OrdinalIgnoreCase)
                     && (forAction is null || string.Equals(action, forAction, StringComparison.OrdinalIgnoreCase));
        return "sidebar-nav__link" + (active ? " active" : "");
    }
    var isAdmin = User.IsInRole(AppRoles.Administrador);
}
<nav class="sidebar-nav">
    <div class="sidebar-nav__group">
        <div class="sidebar-nav__heading">Principal</div>
        <a class="@LinkClass("Home")" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Inicio
        </a>
        <a class="@LinkClass("Assets", "Index")" asp-controller="Assets" asp-action="Index">
            <i class="bi bi-laptop"></i> Inventario
        </a>
    </div>

    <div class="sidebar-nav__group">
        <div class="sidebar-nav__heading">Operación</div>
        <a class="@LinkClass("Assets", "Create")" asp-controller="Assets" asp-action="Create">
            <i class="bi bi-plus-square"></i> Alta
        </a>
        <a class="@LinkClass("Assignments", "Assign")" asp-controller="Assignments" asp-action="Assign">
            <i class="bi bi-person-check"></i> Asignar
        </a>
        <a class="@LinkClass("Assignments", "Asignados")" asp-controller="Assignments" asp-action="Asignados">
            <i class="bi bi-people"></i> Asignados
        </a>
        <a class="@LinkClass("Assignments", "Return")" asp-controller="Assignments" asp-action="Return">
            <i class="bi bi-arrow-return-left"></i> Devolver
        </a>
        <a class="@(controller == "Assignments" && (action == "Responsivas" || action == "Responsiva" || action == "CustodyPdf") ? "sidebar-nav__link active" : LinkClass("Assignments", "Responsivas"))"
           asp-controller="Assignments" asp-action="Responsivas">
            <i class="bi bi-file-earmark-text"></i> Responsivas
        </a>
    </div>

    @if (isAdmin)
    {
        <div class="sidebar-nav__group">
            <div class="sidebar-nav__heading">Administración</div>
            <a class="@LinkClass("Catalogos")" asp-controller="Catalogos" asp-action="Marcas">
                <i class="bi bi-journal-bookmark"></i> Catálogos
            </a>
            <a class="@LinkClass("Usuarios")" asp-controller="Usuarios" asp-action="Index">
                <i class="bi bi-people"></i> Usuarios
            </a>
        </div>
    }
</nav>

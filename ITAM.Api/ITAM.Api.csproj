<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.2.0</Version>
    <InformationalVersion>1.2.0+2026-09-26T18:05:00Z</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ITAM.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <!-- Solo para `dotnet ef` en desarrollo; contentfiles (BuildHost-*) no deben ir al publish. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITAM.Application\ITAM.Application.csproj" />
    <ProjectReference Include="..\ITAM.Infrastructure\ITAM.Infrastructure.csproj" />
    <ProjectReference Include="..\ITAM.Shared\ITAM.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\branding\" />
  </ItemGroup>

  <!-- Por si algún transitive vuelve a copiar BuildHost al publish (no se usa en runtime). -->
  <Target Name="RemoveEfBuildHostsFromPublish" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)BuildHost-net472;$(PublishDir)BuildHost-netcore"
               Condition="Exists('$(PublishDir)BuildHost-net472') Or Exists('$(PublishDir)BuildHost-netcore')" />
  </Target>

</Project>
